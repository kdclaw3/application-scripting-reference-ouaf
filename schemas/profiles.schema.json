{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Script execution profiles",
  "description": "Distinct execution environments and engine selections described by this specification.",
  "type": "array",
  "minItems": 6,
  "maxItems": 6,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "engineCode",
      "scriptTypes",
      "execution",
      "expressionLanguage",
      "description"
    ],
    "properties": {
      "id": {
        "enum": [
          "bpa-1",
          "bpa-legacy",
          "server-1",
          "server-2",
          "server-3",
          "groovy"
        ]
      },
      "name": { "type": "string", "minLength": 1 },
      "engineCode": { "enum": ["F110", "F11C", "F120", "F130", "F1GV"] },
      "scriptTypes": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": ["bpa", "service", "plug-in", "groovy-library"] }
      },
      "execution": { "enum": ["browser", "server"] },
      "expressionLanguage": { "type": "string", "minLength": 1 },
      "description": { "type": "string", "minLength": 10 }
    }
  }
}
