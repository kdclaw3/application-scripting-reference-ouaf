{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BPA structured step reference",
  "description": "Language concepts, field descriptions, behavior, and authored examples for the browser structured-step notation. These representations do not define a server instruction format.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "name",
      "purpose",
      "representation",
      "required",
      "optional",
      "example",
      "behavior",
      "profiles"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^bpa\\.step\\.[a-z-]+$" },
      "name": { "type": "string", "pattern": "^[a-z-]+$" },
      "purpose": { "type": "string", "minLength": 1 },
      "representation": { "enum": ["authorable", "expansion-only"] },
      "profiles": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "enum": ["bpa-1", "bpa-legacy"] }
      },
      "required": {
        "type": "object",
        "additionalProperties": { "type": "string", "minLength": 1 }
      },
      "optional": {
        "type": "object",
        "additionalProperties": { "type": "string", "minLength": 1 }
      },
      "example": {
        "type": "string",
        "pattern": "^examples/steps/[a-z-]+\\.json$"
      },
      "behavior": { "type": "string", "minLength": 1 }
    }
  }
}
